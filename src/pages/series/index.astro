---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getSeriesSummaries } from "../../lib/series";

const posts = (await getCollection("blog")).filter((post) => !post.data.draft);
const seriesSummaries = getSeriesSummaries(posts);
---

<BaseLayout
  title="Series | jhle0"
  description="연결된 글들을 학습 순서대로 묶어 보는 시리즈와 러닝패스 아카이브."
  canonicalPath="/series"
  ogImage="/og/site.svg"
>
  <section class="blog-archive-page">
    <header class="page-intro">
      <p class="eyebrow">Learning Paths</p>
      <h1>Series</h1>
      <p class="intro-copy">
        같은 주제로 이어지는 글을 읽기 순서대로 묶었습니다. 단편 글을 하나의 학습 흐름처럼 따라갈 수 있습니다.
      </p>
    </header>

    {seriesSummaries.length > 0 ? (
      <ul class="tag-post-grid">
        {seriesSummaries.map((series) => (
          <li class="surface-card">
            <article class="entry-related-card">
              <div class="entry-related-card-meta">
                <p class="eyebrow">Series</p>
                <p class="meta">{series.posts.length} posts</p>
              </div>
              <h2>
                <a href={`/series/${series.slug}`}>{series.name}</a>
              </h2>
              <p class="entry-related-card-copy">
                {series.firstPost.data.title}부터 {series.lastPost.data.title}까지 이어지는 학습 흐름입니다.
              </p>
              <ul class="series-list">
                {series.posts.slice(0, 4).map((post, index) => (
                  <li class="series-item">
                    <a href={`/blog/${post.data.slug}`}>
                      {index + 1}. {post.data.title}
                    </a>
                  </li>
                ))}
              </ul>
              <a class="text-link" href={`/series/${series.slug}`}>전체 시리즈 보기</a>
            </article>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-copy">아직 공개된 시리즈가 없습니다.</p>
    )}
  </section>
</BaseLayout>
