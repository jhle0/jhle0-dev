---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getBlogTopicLabel } from "../../lib/blog";
import { getSeriesSummaries } from "../../lib/series";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((post) => !post.data.draft);

  return getSeriesSummaries(posts).map((series) => ({
    params: { series: series.slug },
    props: { series },
  }));
}

const { series } = Astro.props;
---

<BaseLayout
  title={`${series.name} Series | jhle0`}
  description={`${series.name} 시리즈를 학습 순서대로 정리한 러닝패스입니다.`}
  canonicalPath={`/series/${series.slug}`}
  ogImage="/og/site.svg"
>
  <section class="blog-archive-page">
    <header class="page-intro">
      <p class="eyebrow">Learning Path</p>
      <h1>{series.name}</h1>
      <p class="intro-copy">
        총 {series.posts.length}개의 글을 읽기 좋은 순서로 정리했습니다. 새 글은 아래쪽으로 이어지고, 필요한 경우 글마다 지정한 시리즈 순서를 우선합니다.
      </p>
      <a class="text-link" href="/series">← 모든 시리즈</a>
    </header>

    <ol class="tag-post-grid">
      {series.posts.map((post, index) => (
        <li class="surface-card">
          <article class="entry-related-card">
            <div class="entry-related-card-meta">
              <p class="eyebrow">Step {index + 1}</p>
              <a class="topic-pill topic-pill-subtle" href={`/blog?topic=${post.data.topic}`}>
                {getBlogTopicLabel(post.data.topic)}
              </a>
            </div>
            <h2>
              <a href={`/blog/${post.data.slug}`}>{post.data.title}</a>
            </h2>
            <p class="entry-related-card-copy">{post.data.description}</p>
            <div class="entry-related-card-meta">
              <p class="meta">{post.data.pubDate.toISOString().slice(0, 10)}</p>
              <ul class="tag-list entry-related-tags">
                {post.data.tags.slice(0, 4).map((tag) => (
                  <li>
                    <a href={`/tags/${tag}`}>{tag}</a>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
