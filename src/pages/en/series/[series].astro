---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getBlogTopicLabel } from "../../../lib/blog";
import { getSeriesSummaries } from "../../../lib/series";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((post) => !post.data.draft);

  return getSeriesSummaries(posts).map((series) => ({
    params: { series: series.slug },
    props: { series },
  }));
}

const { series } = Astro.props;
---

<BaseLayout
  locale="en"
  title={`${series.name} Series | jhle0`}
  description={`A reading-order learning path for the ${series.name} series.`}
  canonicalPath={`/en/series/${series.slug}`}
  ogImage="/og/site.svg"
>
  <section class="blog-archive-page">
    <header class="page-intro">
      <p class="eyebrow">Learning Path</p>
      <h1>{series.name}</h1>
      <p class="intro-copy">
        {series.posts.length} posts ordered for reading. Newer posts continue lower in the path, and explicit series order is used when available.
      </p>
      <a class="text-link" href="/en/series">← All series</a>
    </header>

    <ol class="tag-post-grid">
      {series.posts.map((post, index) => (
        <li class="surface-card">
          <article class="entry-related-card">
            <div class="entry-related-card-meta">
              <p class="eyebrow">Step {index + 1}</p>
              <a class="topic-pill topic-pill-subtle" href={`/en/blog?topic=${post.data.topic}`}>
                {getBlogTopicLabel(post.data.topic)}
              </a>
            </div>
            <h2>
              <a href={`/en/blog/${post.data.slug}`}>{post.data.title}</a>
            </h2>
            <p class="entry-related-card-copy">{post.data.description}</p>
            <div class="entry-related-card-meta">
              <p class="meta">{post.data.pubDate.toISOString().slice(0, 10)}</p>
              <ul class="tag-list entry-related-tags">
                {post.data.tags.slice(0, 4).map((tag) => (
                  <li>
                    <a href={`/en/tags/${tag}`}>{tag}</a>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
