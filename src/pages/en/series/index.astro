---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getSeriesSummaries } from "../../../lib/series";

const posts = (await getCollection("blog")).filter((post) => !post.data.draft);
const seriesSummaries = getSeriesSummaries(posts);
---

<BaseLayout
  locale="en"
  title="Series | jhle0"
  description="Series and learning paths that group connected posts in reading order."
  canonicalPath="/en/series"
  ogImage="/og/site.svg"
>
  <section class="blog-archive-page">
    <header class="page-intro">
      <p class="eyebrow">Learning Paths</p>
      <h1>Series</h1>
      <p class="intro-copy">
        Connected posts grouped in a reading order so each topic can work like a small curriculum.
      </p>
    </header>

    {seriesSummaries.length > 0 ? (
      <ul class="tag-post-grid">
        {seriesSummaries.map((series) => (
          <li class="surface-card">
            <article class="entry-related-card">
              <div class="entry-related-card-meta">
                <p class="eyebrow">Series</p>
                <p class="meta">{series.posts.length} posts</p>
              </div>
              <h2>
                <a href={`/en/series/${series.slug}`}>{series.name}</a>
              </h2>
              <p class="entry-related-card-copy">
                A learning path from {series.firstPost.data.title} to {series.lastPost.data.title}.
              </p>
              <ul class="series-list">
                {series.posts.slice(0, 4).map((post, index) => (
                  <li class="series-item">
                    <a href={`/en/blog/${post.data.slug}`}>
                      {index + 1}. {post.data.title}
                    </a>
                  </li>
                ))}
              </ul>
              <a class="text-link" href={`/en/series/${series.slug}`}>View full series</a>
            </article>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-copy">No public series yet.</p>
    )}
  </section>
</BaseLayout>
